# === Режим работы ===
# True — локальная разработка на компьютере
# False — рабочий сайт в интернете
DEBUG=True

# Случайная длинная строка. На сервере сгенерируйте новую и храните только в .env
SECRET_KEY=change-me-to-a-long-random-string

# Домены, с которых открывается сайт (через запятую, без https://)
ALLOWED_HOSTS=localhost,127.0.0.1

# Публичный адрес сайта (для ссылок в письмах)
SITE_URL=http://127.0.0.1:8000

# === База данных PostgreSQL ===
DB_NAME=student_portfolio
DB_USER=postgres
DB_PASSWORD=hello
DB_HOST=localhost
DB_PORT=5432

# === Почта (SMTP) ===
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=info@your-traektoria.ru
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=info@your-traektoria.ru
ADMIN_NOTIFICATION_EMAIL=info@your-traektoria.ru

# Резервный SMTP (необязательно)
EMAIL_FALLBACK_HOST=
EMAIL_FALLBACK_PORT=0
EMAIL_FALLBACK_USE_TLS=False
EMAIL_FALLBACK_USE_SSL=False
EMAIL_FALLBACK_HOST_USER=
EMAIL_FALLBACK_HOST_PASSWORD=
EMAIL_FALLBACK_DEFAULT_FROM_EMAIL=
